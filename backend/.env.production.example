APP_NAME="DILG GIP Attendance Tracker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://attendance.example.gov.ph

APP_TIMEZONE=Asia/Manila
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dilg_attendance_tracker
DB_USERNAME=dilg_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=attendance.example.gov.ph
SANCTUM_STATEFUL_DOMAINS=attendance.example.gov.ph

CACHE_STORE=database
QUEUE_CONNECTION=database

DTR_SIGNING_KEY=
QR_SIGNING_KEY=
MAXIMUM_LOCATION_ACCURACY_METERS=50
