APP_NAME="DILG GIP Attendance Tracker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://attendance.example.gov.ph
FRONTEND_DEPLOYMENT=embedded
FRONTEND_API_PROXY=false
FRONTEND_URL=https://attendance.example.gov.ph
TRUSTED_HOSTS=
TRUSTED_PROXIES=127.0.0.1,::1

APP_TIMEZONE=Asia/Manila
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dilg_attendance_tracker
DB_USERNAME=dilg_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=dilg_attendance_session
SESSION_DOMAIN=attendance.example.gov.ph
SANCTUM_STATEFUL_DOMAINS=attendance.example.gov.ph
CORS_ALLOWED_ORIGINS=

CACHE_STORE=database
CACHE_PREFIX=dilg_attendance_
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

DTR_SIGNING_KEY=
QR_SIGNING_KEY=
MAXIMUM_LOCATION_ACCURACY_METERS=100
DASHBOARD_CACHE_SECONDS=30
DTR_SYNC_BATCH_LIMIT=20

MAIL_MAILER=log
MAIL_FROM_ADDRESS=attendance@example.gov.ph
MAIL_FROM_NAME="${APP_NAME}"
