<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny private Laravel files when the host cannot point the domain to /public.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml)$ - [F,L,NC]

    # Serve public files and send all application routes through Laravel.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]
    RewriteRule ^ public/index.php [L]
</IfModule>

Options -Indexes
